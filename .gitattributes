# A PDF written by hand is plain enough that git calls it text, and autocrlf then rewrites
# every line feed in it on checkout - which moves every byte in the file past the first one and
# invalidates the cross-reference table the reader needs. These are bytes, not lines.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary

# The published patch reference is written by PowerShell on Windows when it is refreshed by hand and
# on Linux when the workflow does it. Storing it as LF whichever wrote it keeps the weekly diff down
# to what Microsoft actually changed, instead of every line of a 500-build file.
Client/patch-reference.json text eol=lf
